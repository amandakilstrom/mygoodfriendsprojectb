@page
@model AppRazor.Pages.ListOfFriendsModel
@{
    ViewData["Title"] = "List of Friends";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<!-- Page List of friends -->
<div class="container px-4 py-4" id="list-of-friends">
    <h2 class="pb-2 border-bottom">List of friends</h2>

    <p>Below are a list of friends.</p>
    <p>The database contains @Model.FriendsCount friends.</p>

    <form method="post" class="needs-validation" method="post" novalidate>
        <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
            <div class="col-md-7 col-lg-10">
                <div class="row mb-2 text-center">

                    @if (Model.Friends is not null)
                    {
                        @foreach (var item in Model.Friends)
                        {
                            <div class="col-md-10 themed-grid-col">
                                <a href="~/ViewFriend?id=@item.FriendId">
                                    @item.FirstName @item.LastName
                                </a>
                                @if (item.Address is not null)
                                {
                                    <div>
                                        @item.Address.Country
                                    </div>
                                }
                                else 
                                {
                                    <div>
                                        No address available
                                    </div>
                                }
                            </div>
                        }
                        <nav aria-label="Standard pagination example">
                            <ul class="pagination">
                                <li class="page-item">
                                    <a class="page-link" href="~/ListOfFriends?pagenr=@Model.PrevPageNr" aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                                @for (int i = 0; i < Model.NrVisiblePages; i++)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="~/ListOfFriends?pagenr=@i">@(i + 1)</a>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link" href="~/ListOfFriends?pagenr=@Model.NextPageNr" aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </form>
</div>

