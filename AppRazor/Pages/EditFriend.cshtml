@page
@model AppRazor.Pages.EditFriendModel
@{
    ViewData["Title"] = "Edit Friend";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<div class="container px-4 py-4" id="edit-group">
    <form class="needs-validation" method="post" novalidate>

        <input type="hidden" name="petId" data-seido-selected-item-id-target />
        <input type="hidden" name="quoteId" data-seido-selected-item-id-target />

        <h2 class="pb-2 border-bottom">
            @Model.PageHeader
            <button class="btn btn-primary-outline" type="submit" asp-page-handler="Save">
                <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em">
                    <use xlink:href="#save" />
                </svg>
            </button>
            <button class="btn btn-primary-outline" type="submit" asp-page-handler="Undo">
                <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em">
                    <use xlink:href="#undo" />
                </svg>
            </button>
        </h2>

        <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
            <div class="col-md-7 col-lg-10">

                <!--To keep between Posts -->
                <input asp-for="PageHeader" value="@Model.PageHeader" type="hidden" />

                <!-- Server side validation errors, rough but just in case client side validation is not working or tampered with -->
                @if (Model.ValidationResult.HasErrors)
                {
                    <div class="row g-3">
                        @foreach (var item in Model.ValidationResult.ErrorMsgs)
                        {
                            <span class="alert alert-danger" role="alert">
                                @item
                            </span>
                        }
                    </div>
                }

                <div class="row g-3">

                    <!-- Hidden fields used to bind input model -->
                    <input asp-for="FriendInput.FriendId" type="hidden" />
                    <input asp-for="FriendInput.StatusIM" type="hidden" />
                    <input asp-for="FriendInput.Address.StatusIM" type="hidden" />
                    <input asp-for="FriendInput.Address.AddressId" type="hidden" />

                    <div class="col-sm-6">
                        <label for="firstName" class="form-label">First Name</label>
                        <input type="text" class="form-control" id="firstName" asp-for="FriendInput.FirstName">
                        <span asp-validation-for="FriendInput.FirstName" class="invalid-feedback"></span>
                    </div>

                    <div class="col-sm-6">
                        <label for="lastName" class="form-label">Last Name</label>
                        <input type="text" class="form-control" id="lastName" asp-for="FriendInput.LastName">
                        <span asp-validation-for="FriendInput.LastName" class="invalid-feedback"></span>
                    </div>

                    <div class="col-sm-6">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" class="form-control" id="established" asp-for="FriendInput.Address.Country">
                        <span asp-validation-for="FriendInput.Address.Country" class="invalid-feedback"></span>
                    </div>

                    <div class="col-sm-6">
                        <label for="city" class="form-label">City</label>
                        <input type="text" class="form-control" id="city" asp-for="FriendInput.Address.City">
                        <span asp-validation-for="FriendInput.Address.City" class="invalid-feedback"></span>
                    </div>

                    <div class="col-sm-6">
                        <label for="street" class="form-label">Street</label>
                        <input type="text" class="form-control" id="street" asp-for="FriendInput.Address.StreetAddress">
                        <span asp-validation-for="FriendInput.Address.StreetAddress" class="invalid-feedback"></span>
                    </div>

                    <div class="col-sm-6">
                        <label for="zipCode" class="form-label">Zip code</label>
                        <input type="text" class="form-control" id="zipCode" asp-for="FriendInput.Address.ZipCode">
                        <span asp-validation-for="FriendInput.Address.ZipCode" class="invalid-feedback"></span>
                    </div>

                    <div class="col-sm-6">
                        <label for="email" class="form-label">Email</label>
                        <input type="text" class="form-control" id="email" asp-for="FriendInput.Email">
                        <span asp-validation-for="FriendInput.Email" class="invalid-feedback"></span>
                    </div>

                    <div class="col-sm-6">
                        <label for="birthday" class="form-label">Birthday</label>
                        <input type="text" class="form-control" id="birthday" asp-for="FriendInput.Birthday">
                        <span asp-validation-for="FriendInput.Birthday" class="invalid-feedback"></span>
                    </div>

                </div>


                @if (Model.FriendInput.Pets is not null)
                {
                    <div class="row g-1">
                        <h3 class="pb-2">Pets</h3>

                        <div class="row mb-2 text-center">
                            <div class="col-md-5 themed-grid-head-col">Name</div>
                            <div class="col-md-5 themed-grid-head-col">Kind</div>
                            <div class="col-md-2 themed-grid-head-col">Option</div>
                        </div>
                        @for (int i = 0; i < Model.FriendInput.Pets.Count(); i++)
                        {
                            <div class="row mb-2 text-center @(Model.FriendInput.Pets[i].StatusIM == AppRazor.Pages.EditFriendModel.StatusIM.Deleted? "d-none" : null)">

                                <input asp-for="FriendInput.Pets[i].StatusIM" value="@Model.FriendInput.Pets[i].StatusIM" class="form-control" type="hidden" />
                                <input asp-for="FriendInput.Pets[i].PetId" value="@Model.FriendInput.Pets[i].PetId" class="form-control" type="hidden" />
                                <input asp-for="FriendInput.Pets[i].Name" value="@Model.FriendInput.Pets[i].Name" class="form-control" type="hidden" />
                                <input asp-for="FriendInput.Pets[i].Kind" value="@Model.FriendInput.Pets[i].Kind" class="form-control" type="hidden" />

                                <div class="col-md-5 themed-grid-col">@Model.FriendInput.Pets[i].Name</div>
                                <div class="col-md-5 themed-grid-col">@Model.FriendInput.Pets[i].Kind</div>
                                <div class="col-md-2 themed-grid-col">
                                    <button type="button" class="btn btn-danger btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-seido-selected-item-id="@Model.FriendInput.Pets[i].PetId"
                                    data-seido-modal-body="Are you sure you want to delete this pet?"
                                    data-seido-delete-type="pet">
                                    Del
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="row g-1">
                    <h3 class="pb-2">Quotes</h3>

                    <div class="row mb-2 text-center">
                        <div class="col-md-8 themed-grid-head-col">Quote</div>
                        <div class="col-md-2 themed-grid-head-col">Author</div>
                        <div class="col-md-2 themed-grid-head-col">Option</div>
                    </div>
                    @for (int i = 0; i < Model.FriendInput.Quotes.Count(); i++)
                    {
                        <div class="row mb-2 text-center @(Model.FriendInput.Quotes[i].StatusIM == AppRazor.Pages.EditFriendModel.StatusIM.Deleted? "d-none" : null)">

                            <input asp-for="FriendInput.Quotes[i].StatusIM" value="@Model.FriendInput.Quotes[i].StatusIM" class="form-control" type="hidden" />
                            <input asp-for="FriendInput.Quotes[i].QuoteId" value="@Model.FriendInput.Quotes[i].QuoteId" class="form-control" type="hidden" />
                            <input asp-for="FriendInput.Quotes[i].QuoteText" value="@Model.FriendInput.Quotes[i].QuoteText" class="form-control" type="hidden" />
                            <input asp-for="FriendInput.Quotes[i].Author" value="@Model.FriendInput.Quotes[i].Author" class="form-control" type="hidden" />

                            <div class="col-md-8 themed-grid-col">@Model.FriendInput.Quotes[i].QuoteText</div>
                            <div class="col-md-2 themed-grid-col">@Model.FriendInput.Quotes[i].Author</div>
                            <div class="col-md-2 themed-grid-col">
                                <button type="button" class="btn btn-danger btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-seido-selected-item-id="@Model.FriendInput.Quotes[i].QuoteId"
                                data-seido-modal-body="Are you sure you want to delete this quote?"
                                data-seido-delete-type="quote">
                                Del
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>       
        </div>

        <div class="modal fade" id="deleteModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-danger">Confirm deletion</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <!-- fylls via JS -->
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                        </button>

                        <button type="submit"
                            asp-page-handler="DeletePet"
                            class="btn btn-danger d-none"
                            id="btnDeletePet">
                            Ok
                        </button>

                        <button type="submit"
                            asp-page-handler="DeleteQuote"
                            class="btn btn-danger d-none"
                            id="btnDeleteQuote">
                            Ok
                        </button>
                    </div>
                </div>
            </div>
        </div>


    </form>
</div>

@section script
{
    <!-- -->
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('deleteModal')
            .addEventListener('show.bs.modal', function (event) {

            const btn = event.relatedTarget;

            const id = btn.getAttribute('data-seido-selected-item-id');
            const type = btn.getAttribute('data-seido-delete-type');
            const body = btn.getAttribute('data-seido-modal-body');

            // Modal body text
            this.querySelector('.modal-body').innerText = body;

            // Reset hidden fields
            document.querySelector('[name="petId"]').value = '';
            document.querySelector('[name="quoteId"]').value = '';

            // Hide both OK buttons
            document.getElementById('btnDeletePet').classList.add('d-none');
            document.getElementById('btnDeleteQuote').classList.add('d-none');

            // Show correct button and set id
            if (type === 'pet') {
                document.querySelector('[name="petId"]').value = id;
                document.getElementById('btnDeletePet').classList.remove('d-none');
            }

            if (type === 'quote') {
                document.querySelector('[name="quoteId"]').value = id;
                document.getElementById('btnDeleteQuote').classList.remove('d-none');
            }
        });
    </script>
}