@page
@model AppRazor.Pages.OverviewPageModel
@{
    ViewData["Title"] = "Overview Page";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<!-- Page Overview -->

<div class="container mt-4">

    <h1 class="mb-2">Overview Page</h1>


    <div class="accordion" id="overviewAccordion">
        @for (int i = 0; i < Model.Countries.Count; i++)
        {
            var country = Model.Countries[i];
            var collapseId = $"collapse{i}";
            var headingId = $"heading{i}";

            <div class="accordion-item">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId">
                        @country.Name
                    </button>
                </h2>

                <div id="@collapseId"
                    class="accordion-collapse collapse"
                    data-bs-parents="#overviewAccordion">

                    <div class="accordion-body">

                        @foreach (var city in country.Cities)
                        {
                           <div class="mb-3">
                                <h6 class="mb-1">@city.Name</h6>

                                @if (city.Friends.Any())
                                {
                                   <p>@city.Friends.Count() friends</p>

                                   @if (city.Friends.Pets.Any())
                                   {
                                        <p>@city.Friends.Pets.Count() pets</p>
                                   } 
                                }
                           </div> 
                        }
                    </div>
                </div>

            </div>
        }
    </div>

</div>